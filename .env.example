# ==============================================================================
# RepoMap / DevDiagram Environment Variables & Credentials Template
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================

# ── LLM Configuration ────────────────────────────────────────────────────────
# Works with any OpenAI-compatible endpoint:
# Google Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
# OpenAI:         https://api.openai.com/v1
# OpenRouter:     https://openrouter.ai/api/v1
# Groq:           https://api.groq.com/openai/v1
# Ollama:         http://localhost:11434/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Your LLM API key
LLM_API_KEY=your_llm_api_key_here

# Primary model name to use
LLM_MODEL=gemini-2.5-flash

# (Optional) Separate models for graph generation vs. chat responses
GRAPH_MODEL=gemini-2.5-flash
CHAT_MODEL=gemini-2.5-flash

# ── GitHub API Configuration ──────────────────────────────────────────────────
# Optional but strongly recommended: Raises rate limits from 60 to 5,000 req/hr
# Generate at: https://github.com/settings/tokens (classic token with public_repo or fine-grained read-only)
GITHUB_TOKEN=your_github_personal_access_token_here

# ── Database Configuration ───────────────────────────────────────────────────
# MongoDB connection string:
# Local: mongodb://localhost:27017/repomap
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/repoMap
MONGODB_URI=mongodb://localhost:27017/repomap

# ── Server Configuration ─────────────────────────────────────────────────────
# Port on which the Express backend will listen (default: 3001)
PORT=3001
